[Desktop Entry]
Type=Application
Name=Obelus
# `Development` and not `TextEditor`: the category is only where a launcher
# files it, and that is among the tools for code. Which files it offers to
# open is `MimeType` below, and that is not decided here.
Categories=Development;
GenericName=Code Editor
Comment=A code editor in a window, with the agent built in.
Exec=obg %F
Icon=obelus
Terminal=false
# What `obg` tells Wayland and X11 it is called, in `window.rs`. A desktop
# that cannot match the two draws the window with no icon at all.
StartupWMClass=obelus
MimeType=text/plain;inode/directory;
