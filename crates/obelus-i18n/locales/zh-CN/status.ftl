## 屏幕底部的状态栏。

# 没有检出分支时，代替分支名。
detached = 分离头指针
# 跟在命令面板的快捷键后面：视图自己的按键在命令面板里。
more = 更多
# 状态栏上的列表只响应这一个键。
close = 关闭
# 选择项目的页面上，输入框前的词：正在输入路径，或正在筛选上面的项目。
open = 打开
filter = 筛选
# 路径输入框为空时的提示。
a-directory-or-a-file = 目录，或目录中的文件
narrow-the-list = 筛选列表
# 输入的路径不存在时。
nothing-is-here = 路径不存在

## 关于文件本身的状态，跟在路径后面。

replacing = 改写
read-only = 只读
unsaved = 未保存
# 磁盘上的文件被改动了。
moved = 已在磁盘上更改
deleted = 已删除
# 屏幕上的内容来自旧版本。
stale = 已过时

# 项目目录前的标签。
project = 项目
pull-request = 拉取请求 #{ $number }
issue = 议题 #{ $number }
# 另一个窗口正在就此对话。
talked-about-in-another-window = 正在另一个窗口中对话
# 同上，用另一个窗口所在工作树的名字。
talked-about-in = 正在 { $name } 中对话
notes = 笔记
# 还没勾掉的笔记数。
left-to-come-back-to = { $count } 条待办

## 终端所在的行。

# 读者向上滚动了多少行。
rows-back = 已向上滚动 { $rows } 行
ended = 已结束
stopped-by = 被 { $signal } 终止
exited = 退出码 { $code }
