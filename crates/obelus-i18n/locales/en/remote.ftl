## An Obelus drawn on another machine: what crosses between the window and
## the machine Obelus runs on.

# Two builds of Obelus, by their versions.
do-not-speak-alike = This Obelus is { $ours } and the other is { $theirs }, and they cannot talk to each other
nothing-at-that-address = Nothing is at that address
wrong-key = That is not this server's key
wheel-not-reported = The wheel will not be reported, so it moves the cursor
paste-a-character-at-a-time = Pasting will arrive a character at a time, not in one go

## A picture on the window's clipboard.

picture-too-large = The picture on the clipboard is too large to bring across
no-picture-any-more = The clipboard no longer holds a picture
window-went = The window closed before the picture came across

## A file dropped on the window, by its name.

folder-not-sent = A folder cannot be sent: { $name }
too-large-to-send = Larger than { $mib } MiB, so not sent: { $name }
could-not-read = Could not read { $name }: { $error }
not-all-came-across = Not all of { $name } came across, so it was not kept
too-large-to-keep = Too large to bring across, so not kept: { $name }
nowhere-to-keep-dropped = Nowhere to keep what was dropped: { $error }
# A directory another user of the machine could read or write.
not-yours-alone = Nothing was kept, because { $path } is not yours alone
not-a-file-name = Not a file's name: { $name }
nowhere-to-keep = Nowhere to keep { $name }: { $error }
could-not-keep-because = Could not keep { $name }: { $error }
could-not-keep = Could not keep { $name }
