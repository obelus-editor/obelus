## A question the agent asks: what an answer is still short of, beside the
## row that sends it, and why an answer from a chat will not do.

choose-at-least = Choose at least { $count }
choose-at-most = Choose at most { $count }
choose-one = Choose one
# The agent's own word for the answer it wants written, first.
first = { $what } first
an-answer-first = Write an answer first
not-an-answer = That is not one of the answers
just-one = Choose just one
takes-no-words = This question takes no written answer
choose-one-as-well = Choose one as well
# The agent's own word for the answer it wants written.
as-well = { $what } as well
an-answer-as-well = Write an answer as well
