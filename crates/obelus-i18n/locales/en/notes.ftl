## The notes.

nothing = Nothing to come back to

## The keys, as the palette says them over the notes: a word, and after
## `-about` what it does.

another = New note
another-about = Start a new note after this one
done = Done
done-about = Tick this note off, or put it back
go-there = Go to
go-there-about = Go to the place this note is about
delete = Delete
delete-about = Delete this note and the notes under it
move-it = Move
move-about = Move this note past the one next to it
indent = Indent
indent-about = Put this note under the one above it
outdent = Outdent
outdent-about = Bring this note out from under the one above

## A note that points at a place.

# Where the file still has the note and the line it was about is gone.
line-gone = { $path } (line gone)
