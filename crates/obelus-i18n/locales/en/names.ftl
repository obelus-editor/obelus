## The list of fonts a window tries in order, opened from the `fonts`
## setting.

remove = Remove
remove-about = Remove this font from the list
add = Add
add-about = Add this font to the list
move-it = Move
move-about = Change the order the fonts are tried in
# On the rule above the fonts this machine has.
on-this-machine = On this machine
# Beside a font in the list that this machine does not have.
not-on-this-machine = Not on this machine
# Where no font is chosen, by the face the machine calls monospaced.
nothing-chosen = None chosen, so { $face }
nothing-chosen-at-all = None chosen, so the system's monospaced font
