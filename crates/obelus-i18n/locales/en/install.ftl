## Installing an agent or a theme: why it did not work, as said on its
## card. Lowercase where it starts with what went wrong on the way, because
## a reason is often said after something else.

could-not-download = could not download it: { $error }
download-interrupted = the download was interrupted: { $error }
could-not-unpack = could not unpack it: { $error }
# By the archive's name, which says its shape.
cannot-unpack = Obelus cannot unpack { $name }
download-does-not-match = The download does not match its checksum
package-does-not-match = The package does not match its checksum
wallpaper-does-not-match = The wallpaper does not match its checksum
wallpaper-did-not-arrive = The wallpaper did not arrive
# The reason, after the colon.
wallpaper-did-not-arrive-because = The wallpaper did not arrive: { $why }
not-a-directory-name = Obelus cannot make a directory called { $name }
another-is-installing = Another Obelus is installing { $name }
nothing-to-run = Installed, but Obelus cannot tell what to run
no-npm = No npm on the PATH
npm-gave-no-reason = No reason from npm
# The program the agent is run as.
not-in-the-archive = The archive has no { $command }
# The theme's file, by its name.
not-in-the-package = The package has no { $file }
theme-unreadable = Obelus cannot read the theme it was sent: { $why }
not-from-the-registry = Not installed from the registry: { $name }
