## The keys of a list, said on its row and on the palette's first tab: a
## word, and after `-about` what it does.

# The agent's background tasks.
stop = Stop
stop-about = Stop this task
collapse = Collapse
collapse-about = Hide what is under this row
expand = Expand
expand-about = Show what this row holds
go-there = Go to
go-there-about = Go to the place this row names
# The open documents.
move-it = Move
move-about = Change the order of the open documents

## Enter on a worktree, in a window.

# Another window is on that worktree.
bring = Switch to it
bring-about = Bring the window on that worktree forward
# The worktree is this window's own.
stay = Stay
stay-about = Close the list and stay in this window
switch = Switch
switch-about = Open that worktree in this window
new-window = New window
new-window-about = Open that worktree in a new window

## Searching.

regex = Regex
regex-about = Use regular expression
word = Word
word-about = Match whole word
case = Case
case-about = Match case
outside = Outside
outside-about = Include symbols outside the project
ignored-files = Ignored files
search-ignored-about = Search files the project ignores too
hidden-files = Hidden files
search-hidden-about = Search hidden files too

## The file list.

offer-ignored-about = Show files the project ignores
offer-hidden-about = Show hidden files
rename = Rename
rename-about = Rename or move the file or folder on this row

## The list itself.

# The tab every row is on.
all = All
# The tab of rows that have changed.
changed = Changed
nothing-to-choose-from = Nothing to choose from
# The way out of a question the agent asks, under its answers.
cancel = Cancel
# While the rows are being scored against what was typed.
matching = Matching…
no-match = No match
