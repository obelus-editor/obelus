## The page that asks which project to open.

title = Open a project
# The row under the projects, which opens one not in the list.
open-another = Open another…
# The same row where nothing is remembered, so there is nothing for it to
# be another of.
type-a-path = Type a path…
# The row under that one, which goes to an Obelus on another machine.
connect = Connect to remote…
no-match = No project matches

## The keys at the page's foot.

# Enter on the row that opens a project not in the list.
type-it = Type a path
# Enter on the row that goes to another machine.
choose-a-machine = Choose a machine
open = Open
# Takes what is offered into the box.
fill-it-in = Complete
# Takes the project off the list.
forget = Remove from list
# The key that quits Obelus.
leave = Quit
