## What the status row writes in front of a box it asks something in. Each
## ends where the answer starts, so the English keeps a space after its
## colon.

# By the name of what is being asked for: a setting, a variable, a field.
asking-for = { $name }:{ " " }
new-variable = New variable:{ " " }
# The name typed for a new variable started with a digit.
not-a-digit = A name cannot start with a digit:{ " " }
line = Go to line:{ " " }
# The machine to connect to.
server = Connect to:{ " " }
server-key = Key:{ " " }
rename-symbol = Rename to:{ " " }
rename-file = Rename or move to:{ " " }
new-file = New file:{ " " }
