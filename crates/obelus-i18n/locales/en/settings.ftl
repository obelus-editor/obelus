## The tabs of the settings page, and the keys page's heading.

group-appearance = Appearance
group-reading = Reading
group-files = Files
group-agent = Agent
group-keys = Keys

## Each setting's name, by its key in the file with hyphens for
## underscores, and what it does after `-about` where it needs saying --
## in the words an editor's settings use, and short.

theme = Theme
icons = Nerd Font icons
icons-about = Your terminal's font has to be a Nerd Font, or each icon is a box
language = Language
wrap = Word wrap
blame-margin = Blame
blame-margin-about = At the end of the cursor's line
tab-width = Tab size
tab-width-about = Also how many spaces Tab inserts
fonts = Fonts
fonts-about = Tried in order
animation = Animations
bar-tabs = Tabs in title bar
bar-tabs-about = Makes the title bar taller
font-size = Font size
font-size-about = In points
picture-strength = Background image strength
picture-strength-about = A percentage of the theme's own
hover-delay = Hover delay
hover-delay-about = In milliseconds. 0 turns it off
read-only = Read-only
read-only-about = The agent can still write
language-servers = Language servers
language-servers-about = Start one when a file is opened. When off, restart-server still starts one
format-on-save = Format on save
code-actions-on-save = Code actions on save
code-actions-on-save-about = Such as organizing imports
inlay-hints = Inlay hints
inlay-hints-about = Inferred types and parameter names
diagnostics = Inline diagnostics
diagnostics-about = Show the problem message below the cursor's line
new-versions = Check for updates
new-versions-about = Once a day. A new version is mentioned on the welcome screen
ignored-files = Show ignored files
ignored-files-about = In the file list
hidden-files = Show hidden files
hidden-files-about = In the file list, including .git
reopen = Restore open files
reopen-about = With the cursor where you left it
recent-projects = Recent projects
workflow = Workflow
workflow-about = How the agent changes this project
build-jobs = Build jobs
build-jobs-about = For everything Obelus starts, shared by every Obelus on this machine
speaks-as = Agent name
speaks-as-about = What the agent calls itself in a conversation, so that "I" there always means you
conversation-days = Conversation history
conversation-days-about = For conversations not about a note, which go with their note. 0 keeps them all
keys-from = Keymap
keys-from-about = The key bindings your own are laid over

## What each keymap is. Its name is a name, and not here.

layout-obelus-about = Function keys, in banks of four
layout-mnemonic-about = Ctrl and Alt with the word's first letter. In Obelus's terminal they go to the shell
layout-vscode-about = Without function keys
layout-textmate-about = Without function keys

## The `language` setting's own word. Each language is offered by its own
## name, which is not a message: see `Language::name`.

language-auto = System default
