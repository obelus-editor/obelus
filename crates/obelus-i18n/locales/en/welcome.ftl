## The welcome screen.

# Set into the foot of the plate, beside the version running.
newer-is-out = v{ $version } is out

## What each key under the plate opens. Two of these and their keys share
## a line under a plate fifty columns wide, so each has thirteen columns:
## the palette's title where it fits, and the thing opened where it does not.

open-file = Open file
changed-files = Changed files
find-in-files = Find in files
ask-the-agent = Ask the agent
run-command = Run command
quit = Quit
