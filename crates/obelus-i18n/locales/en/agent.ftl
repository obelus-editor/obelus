## What Obelus makes of what an agent sends, where it says something of its
## own.

# In place of a part of a message that is not words.
an-image = (an image)
audio = (audio)
a-resource = (a resource)
# Why a conversation could not be picked up, after a colon.
cannot-resume = this agent cannot resume a conversation
# A question the agent asked that Obelus cannot put: the field's name, and
# what the protocol says it is.
kind-not-asked = { $field } is of a kind Obelus cannot ask for: { $kind }
list-of-a-kind-not-asked = { $field } is a list of a kind Obelus cannot ask for: { $kind }
